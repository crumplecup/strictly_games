let rec bj_dealer_turn_creusot
  [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot/generated/blackjack.rs" 106 0 109 55]
  (state: t_BlackjackState) (proof: t_Established_BlackjackConsistent)
  (return (x: tup2_BlackjackState_Established_BlackjackConsistent)) =
  {[@stop_split] [@expl:bj_dealer_turn_creusot requires] ([@stop_split] [@expl:bj_dealer_turn_creusot 'state' type invariant] [%#sblackjack'0] inv_BlackjackState state)
  /\ ([@stop_split] [@expl:bj_dealer_turn_creusot 'proof' type invariant] [%#sblackjack'1] inv_Established_BlackjackConsistent proof)
  /\ ([@stop_split] [@expl:bj_dealer_turn_creusot requires] [%#sblackjack'2] blackjack_consistent_creusot state)}
  (! bb0
  [ bb0 = s0
    [ s0 = bj_dealer_turn [%#sblackjack] {state} {proof}
        (fun (_x: tup2_BlackjackState_Established_BlackjackConsistent) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: tup2_BlackjackState_Established_BlackjackConsistent = Any.any_l ()
  | & state: t_BlackjackState = state
  | & proof: t_Established_BlackjackConsistent = proof ])
  [ return (result: tup2_BlackjackState_Established_BlackjackConsistent) ->
  {[@stop_split] [@expl:bj_dealer_turn_creusot ensures] ([@stop_split] [@expl:bj_dealer_turn_creusot result type invariant] [%#sblackjack'3] inv_tup2_BlackjackState_Established_BlackjackConsistent result)
    /\ ([@stop_split] [@expl:bj_dealer_turn_creusot ensures] [%#sblackjack'4] blackjack_consistent_creusot result.f0)}
    (! return {result}) ]

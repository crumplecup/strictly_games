use creusot.int.UInt64
use creusot.slice.Slice64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_GameSetup

type t_BlackjackDisplayMode = Table | Scorecard

type t_Shoe

type t_GameBetting = { shoe: t_Shoe; bankroll: UInt64.t }

type t_Hand

type t_BankrollLedger = { post_bet_balance: UInt64.t; bet: UInt64.t }

type t_Established_BetDeducted

type t_GamePlayerTurn = {
  shoe'0: t_Shoe;
  player_hands'0: Slice64.array t_Hand;
  num_hands'0: UInt64.t;
  current_hand_index'0: UInt64.t;
  dealer_hand'0: t_Hand;
  bets'0: Slice64.array UInt64.t;
  ledger'0: t_BankrollLedger;
  bet_deducted'0: t_Established_BetDeducted }

type t_GameDealerTurn = {
  shoe'1: t_Shoe;
  player_hands'1: Slice64.array t_Hand;
  num_hands'1: UInt64.t;
  dealer_hand'1: t_Hand;
  bets'1: Slice64.array UInt64.t;
  ledger'1: t_BankrollLedger;
  bet_deducted'1: t_Established_BetDeducted }

type t_Outcome = Win | Blackjack | Push | Loss | Surrender

type t_GameFinished = {
  player_hands'2: Slice64.array t_Hand;
  num_hands'2: UInt64.t;
  dealer_hand'2: t_Hand;
  bets'2: Slice64.array UInt64.t;
  outcomes'2: Slice64.array t_Outcome;
  bankroll'2: UInt64.t }

type t_BlackjackState =
  | Setup t_GameSetup t_BlackjackDisplayMode
  | Betting t_GameBetting t_BlackjackDisplayMode
  | PlayerTurn t_GamePlayerTurn t_BlackjackDisplayMode
  | DealerTurn t_GameDealerTurn t_BlackjackDisplayMode
  | Finished t_GameFinished t_BlackjackDisplayMode

type t_Established_BlackjackConsistent

type tup2_BlackjackState_Established_BlackjackConsistent = {
  f0: t_BlackjackState;
  f1: t_Established_BlackjackConsistent }

predicate inv_GameSetup (_1: t_GameSetup)

predicate inv_Shoe (_1: t_Shoe)

predicate inv_GameBetting (_1: t_GameBetting)

axiom inv_axiom [@rewrite]: forall x: t_GameBetting [inv_GameBetting x]. inv_GameBetting x = inv_Shoe x.shoe

predicate inv_Hand (_1: t_Hand)

predicate invariant_ref_Hand [@inline:trivial] (self: t_Hand) = [%#sinvariant] inv_Hand self

meta "rewrite_def" predicate invariant_ref_Hand

predicate inv_ref_Hand [@inline:trivial] (_1: t_Hand) = invariant_ref_Hand _1

meta "rewrite_def" predicate inv_ref_Hand

predicate invariant_Seq_Hand [@inline:trivial] (self: Seq.seq t_Hand) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_Hand (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_Hand

predicate inv_Seq_Hand [@inline:trivial] (_1: Seq.seq t_Hand) = invariant_Seq_Hand _1

meta "rewrite_def" predicate inv_Seq_Hand

predicate invariant_array_Hand_4 (self: Slice64.array t_Hand) =
  [%#sarray] inv_Seq_Hand (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_Hand_4 [@inline:trivial] (_1: Slice64.array t_Hand) = invariant_array_Hand_4 _1

meta "rewrite_def" predicate inv_array_Hand_4

predicate inv_Seq_u64 [@inline:trivial] (_1: Seq.seq UInt64.t) = true

meta "rewrite_def" predicate inv_Seq_u64

predicate invariant_array_u64_4 (self: Slice64.array UInt64.t) =
  [%#sarray] inv_Seq_u64 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u64_4 [@inline:trivial] (_1: Slice64.array UInt64.t) = invariant_array_u64_4 _1

meta "rewrite_def" predicate inv_array_u64_4

predicate inv_Established_BetDeducted (_1: t_Established_BetDeducted)

predicate inv_GamePlayerTurn (_1: t_GamePlayerTurn)

axiom inv_axiom'0 [@rewrite]: forall x: t_GamePlayerTurn [inv_GamePlayerTurn x]. inv_GamePlayerTurn x
    = (inv_Shoe x.shoe'0
    /\ inv_array_Hand_4 x.player_hands'0
    /\ inv_Hand x.dealer_hand'0 /\ inv_array_u64_4 x.bets'0 /\ inv_Established_BetDeducted x.bet_deducted'0)

predicate inv_GameDealerTurn (_1: t_GameDealerTurn)

axiom inv_axiom'1 [@rewrite]: forall x: t_GameDealerTurn [inv_GameDealerTurn x]. inv_GameDealerTurn x
    = (inv_Shoe x.shoe'1
    /\ inv_array_Hand_4 x.player_hands'1
    /\ inv_Hand x.dealer_hand'1 /\ inv_array_u64_4 x.bets'1 /\ inv_Established_BetDeducted x.bet_deducted'1)

predicate inv_Seq_Outcome [@inline:trivial] (_1: Seq.seq t_Outcome) = true

meta "rewrite_def" predicate inv_Seq_Outcome

predicate invariant_array_Outcome_4 (self: Slice64.array t_Outcome) =
  [%#sarray] inv_Seq_Outcome (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_Outcome_4 [@inline:trivial] (_1: Slice64.array t_Outcome) = invariant_array_Outcome_4 _1

meta "rewrite_def" predicate inv_array_Outcome_4

predicate inv_GameFinished (_1: t_GameFinished)

axiom inv_axiom'2 [@rewrite]: forall x: t_GameFinished [inv_GameFinished x]. inv_GameFinished x
    = (inv_array_Hand_4 x.player_hands'2
    /\ inv_Hand x.dealer_hand'2 /\ inv_array_u64_4 x.bets'2 /\ inv_array_Outcome_4 x.outcomes'2)

predicate inv_BlackjackState (_1: t_BlackjackState)

axiom inv_axiom'3 [@rewrite]: forall x: t_BlackjackState [inv_BlackjackState x]. inv_BlackjackState x
    = match x with
      | Setup inner display_mode -> inv_GameSetup inner
      | Betting inner display_mode -> inv_GameBetting inner
      | PlayerTurn inner display_mode -> inv_GamePlayerTurn inner
      | DealerTurn inner display_mode -> inv_GameDealerTurn inner
      | Finished inner display_mode -> inv_GameFinished inner
      end

predicate inv_Established_BlackjackConsistent (_1: t_Established_BlackjackConsistent)

constant const_MAX_PLAYER_HANDS: UInt64.t = [%#shand] (4: UInt64.t)

predicate blackjack_consistent_creusot [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot/generated/blackjack.rs" 22 0 22 73] (state: t_BlackjackState) =
  [%#sblackjack'9] match state with
    | Setup _ _ -> true
    | Betting inner _ -> UInt64.t'int inner.bankroll > 0
    | PlayerTurn inner _ -> UInt64.t'int inner.current_hand_index'0 < UInt64.t'int inner.num_hands'0
    | DealerTurn _ _ -> true
    | Finished inner _ -> UInt64.t'int inner.num_hands'2 <= UInt64.t'int const_MAX_PLAYER_HANDS
    end

predicate inv_tup2_BlackjackState_Established_BlackjackConsistent [@inline:trivial] (_1: tup2_BlackjackState_Established_BlackjackConsistent) =
  inv_BlackjackState _1.f0 /\ inv_Established_BlackjackConsistent _1.f1

meta "rewrite_def" predicate inv_tup2_BlackjackState_Established_BlackjackConsistent

let rec bj_dealer_turn (state: t_BlackjackState) (proof: t_Established_BlackjackConsistent)
  (return (x: tup2_BlackjackState_Established_BlackjackConsistent)) =
  {[@stop_split] [@expl:bj_dealer_turn requires] ([@stop_split] [@expl:bj_dealer_turn 'state' type invariant] [%#sblackjack'5] inv_BlackjackState state)
  /\ ([@stop_split] [@expl:bj_dealer_turn 'proof' type invariant] [%#sblackjack'6] inv_Established_BlackjackConsistent proof)
  /\ ([@stop_split] [@expl:bj_dealer_turn requires] [%#sblackjack'7] blackjack_consistent_creusot state)}
  any
  [ return (result: tup2_BlackjackState_Established_BlackjackConsistent) ->
  {[@stop_split] [@expl:bj_dealer_turn ensures] ([@stop_split] [@expl:bj_dealer_turn result type invariant] [%#svsm] inv_tup2_BlackjackState_Established_BlackjackConsistent result)
    /\ ([@stop_split] [@expl:bj_dealer_turn ensures] [%#sblackjack'8] blackjack_consistent_creusot result.f0)}
    (! return {result}) ]


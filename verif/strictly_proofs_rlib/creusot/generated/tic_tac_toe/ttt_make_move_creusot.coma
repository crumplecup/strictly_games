use creusot.prelude.Any
use int.Int

type t_GameSetup

type t_Position =
  | TopLeft
  | TopCenter
  | TopRight
  | MiddleLeft
  | Center
  | MiddleRight
  | BottomLeft
  | BottomCenter
  | BottomRight

type t_TttDisplayMode = Board | BoardWithCursor t_Position | BoardHistory

type t_Board

type t_Vec_Move_Global

type t_Player = X | O

type t_GameInProgress = { board: t_Board; history: t_Vec_Move_Global; to_move: t_Player }

type t_Outcome = Winner t_Player | Draw

type t_GameFinished = { board'0: t_Board; history'0: t_Vec_Move_Global; outcome'0: t_Outcome }

type t_TicTacToeState =
  | Setup t_GameSetup t_TttDisplayMode
  | InProgress t_GameInProgress t_TttDisplayMode
  | Finished t_GameFinished t_TttDisplayMode

type t_Established_TicTacToeConsistent

type t_Move = { player: t_Player; position: t_Position }

type t_Established_SquareEmpty

type t_Established_PlayerTurn


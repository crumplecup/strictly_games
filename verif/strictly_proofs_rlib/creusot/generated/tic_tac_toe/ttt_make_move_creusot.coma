  f1: t_Established_TicTacToeConsistent }

predicate inv_GameSetup (_1: t_GameSetup)

predicate inv_Board (_1: t_Board)

predicate inv_GameInProgress (_1: t_GameInProgress)

axiom inv_axiom [@rewrite]: forall x: t_GameInProgress [inv_GameInProgress x]. inv_GameInProgress x = inv_Board x.board

predicate inv_GameFinished (_1: t_GameFinished)

axiom inv_axiom'0 [@rewrite]: forall x: t_GameFinished [inv_GameFinished x]. inv_GameFinished x = inv_Board x.board'0

predicate inv_TicTacToeState (_1: t_TicTacToeState)

axiom inv_axiom'1 [@rewrite]: forall x: t_TicTacToeState [inv_TicTacToeState x]. inv_TicTacToeState x
    = match x with
      | Setup inner display_mode -> inv_GameSetup inner
      | InProgress inner display_mode -> inv_GameInProgress inner
      | Finished inner display_mode -> inv_GameFinished inner
      end


  (! bb0
  [ bb0 = any
    [ br0 -> {state = Setup} (! bb1)
    | br1 (x0: t_MiniInProgress) -> {state = InProgress x0} (! bb3)
    | br2 (x0: t_MiniInProgress) -> {state = Done x0} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- state ] s1 | s1 = return {_ret} ]
  | bb3 = s0
    [ s0 = elim_InProgress {state} (fun (rinner: t_MiniInProgress) -> [ &inner <- rinner ] s1)
    | s1 = [ &_ret <- Done inner ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: t_MiniState = Any.any_l () | & state: t_MiniState = state | & inner: t_MiniInProgress = Any.any_l () ])
  [ return (result: t_MiniState) -> {[@stop_split] [@expl:sgc4_finish ensures] [%#slevel4'0] sgc4_invariant result}
    (! return {result}) ]

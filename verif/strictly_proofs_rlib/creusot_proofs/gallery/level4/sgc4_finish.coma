use creusot.prelude.Any
use seq.Seq
use creusot.int.UInt8
use creusot.int.UInt64
use int.Int

type t_Vec_u8_Global

type t_MiniInProgress = { history: t_Vec_u8_Global }

type t_MiniState = Setup | InProgress t_MiniInProgress | Done t_MiniInProgress

let rec elim_InProgress (_x: t_MiniState) (return (inner: t_MiniInProgress)) = any
  [ _k (inner: t_MiniInProgress) -> {InProgress inner = _x} (! return {inner})
  | _chk -> (! {[@expl:elim InProgress] match _x with
      | InProgress _ -> true
      | _ -> false
      end}
    any) ]

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec: forall self: t_Vec_u8_Global. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

predicate sgc4_invariant [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/gallery/level4.rs" 67 0 67 48] (state: t_MiniState) =
  [%#slevel4'1] match state with
    | Setup -> true
    | InProgress inner -> Seq.length (view_Vec_u8_Global inner.history) <= 9
    | Done inner -> Seq.length (view_Vec_u8_Global inner.history) >= 1
    end

predicate sgc4_has_move [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/gallery/level4.rs" 90 0 90 47] (state: t_MiniState) =
  [%#slevel4'2] match state with
    | InProgress inner -> Seq.length (view_Vec_u8_Global inner.history) >= 1
    | _ -> false
    end


use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_MiniGameState = Setup | Active UInt64.t | Done UInt64.t

predicate sgc1_invariant [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/gallery/level1.rs" 42 0 42 52] (state: t_MiniGameState) =
  [%#slevel1'2] match state with
    | Setup -> true
    | Active count -> UInt64.t'int count <= 9
    | Done count -> UInt64.t'int count >= 1
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec sgc1_begin
  [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/gallery/level1.rs" 71 0 71 56]
  (state: t_MiniGameState) (return (x: t_MiniGameState)) =
  {[@stop_split] [@expl:sgc1_begin requires] [%#slevel1'0] sgc1_invariant state}
  (! bb0
  [ bb0 = any
    [ br0 -> {state = Setup} (! bb3)
    | br1 (x0: UInt64.t) -> {state = Active x0} (! bb1)
    | br2 (x0: UInt64.t) -> {state = Done x0} (! bb1) ]
  | bb1 = s0 [ s0 = [ &other <- state ] s1 | s1 = [ &_ret <- other ] s2 | s2 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- Active ([%#slevel1] (0: UInt64.t)) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_MiniGameState = Any.any_l ()

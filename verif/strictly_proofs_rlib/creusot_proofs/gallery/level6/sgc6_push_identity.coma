let rec sgc6_push_identity
  [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/gallery/level6.rs" 119 0 119 57]
  (bankroll: UInt64.t) (bet: UInt64.t) (return (x: UInt64.t)) =
  {[@stop_split] [@expl:sgc6_push_identity requires] ([@stop_split] [@expl:sgc6_push_identity requires #0] [%#slevel6'1] UInt64.gt bet (0: UInt64.t))
  /\ ([@stop_split] [@expl:sgc6_push_identity requires #1] [%#slevel6'2] UInt64.le bet bankroll)}
  (! bb0
  [ bb0 = s0
    [ s0 = sgc6_debit [%#slevel6] {bankroll} {bet} (fun (_x: UInt64.t) -> [ &post_bet <- _x ] s1)
    | s1 = [ &_14 <- Push ] s2
    | s2 = sgc6_settle [%#slevel6'0] {post_bet} {_14} {bet} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s3)
    | s3 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & bankroll: UInt64.t = bankroll
  | & bet: UInt64.t = bet
  | & post_bet: UInt64.t = Any.any_l ()
  | & _14: t_Outcome = Any.any_l () ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:sgc6_push_identity ensures] [%#slevel6'3] UInt64.t'int result
    = UInt64.t'int bankroll}

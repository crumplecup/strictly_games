  [ bb0 = any
    [ br0 -> {outcome = Win} (! bb8)
    | br1 -> {outcome = Blackjack} (! bb6)
    | br2 -> {outcome = Push} (! bb10)
    | br3 -> {outcome = Loss} (! bb9)
    | br4 -> {outcome = Surrender} (! bb7) ]
  | bb7 = s0
    [ s0 = [ &_12 <- ([%#sbankroll_financial] (2: UInt64.t)) = ([%#sbankroll_financial'0] (0: UInt64.t)) ] s1
    | s1 = {[@expl:division by zero] [%#sbankroll_financial'0] not _12} s2
    | s2 = UInt64.div [%#sbankroll_financial'0] {bet} {[%#sbankroll_financial] (2: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &_ret <- _x ] s3)
    | s3 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- [%#sbankroll_financial'1] (0: UInt64.t) ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- bet ] s1 | s1 = return {_ret} ]
  | bb6 = s0
    [ s0 = UInt64.mul [%#sbankroll_financial'3] {bet} {[%#sbankroll_financial'2] (2: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &_13 <- _x ] s1)
    | s1 = [ &_17 <- ([%#sbankroll_financial'4] (2: UInt64.t)) = ([%#sbankroll_financial'5] (0: UInt64.t)) ] s2
    | s2 = {[@expl:division by zero] [%#sbankroll_financial'5] not _17} s3
    | s3 = UInt64.div [%#sbankroll_financial'5] {bet} {[%#sbankroll_financial'4] (2: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &_15 <- _x ] s4)
    | s4 = UInt64.add [%#sbankroll_financial'6] {_13} {_15} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s5)
    | s5 = return {_ret} ]
  | bb8 = s0
    [ s0 = UInt64.mul [%#sbankroll_financial'8] {bet} {[%#sbankroll_financial'7] (2: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & outcome: t_Outcome = outcome
  | & bet: UInt64.t = bet
  | & _12: bool = Any.any_l ()
  | & _13: UInt64.t = Any.any_l ()
  | & _15: UInt64.t = Any.any_l ()
  | & _17: bool = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:inline_gross_return ensures] [%#sbankroll_financial'10] UInt64.t'int result
    = gross_return_spec outcome bet}
    (! return {result}) ]

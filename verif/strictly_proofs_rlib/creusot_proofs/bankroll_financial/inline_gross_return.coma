use creusot.int.UInt64
use creusot.prelude.Any
use int.ComputerDivision
use int.Int

type t_Outcome = Win | Blackjack | Push | Loss | Surrender

function gross_return_spec [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/bankroll_financial.rs" 49 0 49 59] (outcome: t_Outcome) (bet: UInt64.t) : int
 = [%#sbankroll_financial'11] match outcome with
    | Push -> UInt64.t'int bet
    | Loss -> 0
    | Win -> UInt64.t'int bet * 2
    | Surrender -> ComputerDivision.div (UInt64.t'int bet) 2
    | Blackjack -> UInt64.t'int bet * 2 + ComputerDivision.div (UInt64.t'int bet) 2
    end

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec inline_gross_return
  [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/bankroll_financial.rs" 65 0 65 57]
  (outcome: t_Outcome) (bet: UInt64.t) (return (x: UInt64.t)) =
  {[@stop_split] [@expl:inline_gross_return requires] [%#sbankroll_financial'9] gross_return_spec outcome bet
  <= UInt64.t'int const_MAX}

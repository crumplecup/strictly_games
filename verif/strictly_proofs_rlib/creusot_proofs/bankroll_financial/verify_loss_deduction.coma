let rec verify_loss_deduction
  [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/bankroll_financial.rs" 109 0 109 60]
  (bankroll: UInt64.t) (bet: UInt64.t) (return (x: UInt64.t)) =
  {[@stop_split] [@expl:verify_loss_deduction requires] ([@stop_split] [@expl:verify_loss_deduction requires #0] [%#sbankroll_financial'2] UInt64.gt bet (0: UInt64.t))
  /\ ([@stop_split] [@expl:verify_loss_deduction requires #1] [%#sbankroll_financial'3] UInt64.le bet bankroll)}
  (! bb0
  [ bb0 = s0
    [ s0 = UInt64.sub [%#sbankroll_financial] {bankroll} {bet} (fun (_x: UInt64.t) -> [ &post_bet <- _x ] s1)
    | s1 = [ &_16 <- Loss ] s2
    | s2 = inline_gross_return [%#sbankroll_financial'0] {_16} {bet} (fun (_x: UInt64.t) -> [ &_15 <- _x ] s3)
    | s3 = UInt64.add [%#sbankroll_financial'1] {post_bet} {_15} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s4)
    | s4 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & bankroll: UInt64.t = bankroll
  | & bet: UInt64.t = bet
  | & post_bet: UInt64.t = Any.any_l ()
  | & _15: UInt64.t = Any.any_l ()
  | & _16: t_Outcome = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:verify_loss_deduction ensures] [%#sbankroll_financial'4] UInt64.t'int result
    = UInt64.t'int bankroll - UInt64.t'int bet}
    (! return {result}) ]

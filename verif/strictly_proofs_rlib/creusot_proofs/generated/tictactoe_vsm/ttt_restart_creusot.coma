type t_Move = { player: t_Player; position: t_Position }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Move_Global (self: t_Vec_Move_Global) : Seq.seq t_Move

axiom view_Vec_Move_Global_spec: forall self: t_Vec_Move_Global. [%#svec] Seq.length (view_Vec_Move_Global self)
    <= UInt64.t'int const_MAX

predicate tictactoe_consistent [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/generated/tictactoe_vsm.rs" 18 0 18 59] (state: t_TicTacToeState) =

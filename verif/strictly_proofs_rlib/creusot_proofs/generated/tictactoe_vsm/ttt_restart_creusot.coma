let rec elim_Finished (_x: t_TicTacToeState) (return (inner: t_GameFinished) (display_mode: t_TttDisplayMode)) = any
  [ _k (inner: t_GameFinished) (display_mode: t_TttDisplayMode) -> {Finished inner display_mode = _x}
    (! return {inner} {display_mode})
  | _chk -> (! {[@expl:elim Finished] match _x with
      | Finished _ _ -> true
      | _ -> false
      end}
    any) ]

predicate inv_Board (_1: t_Board)

predicate inv_GameFinished (_1: t_GameFinished)

axiom inv_axiom [@rewrite]: forall x: t_GameFinished [inv_GameFinished x]. inv_GameFinished x = inv_Board x.board'0

predicate inv_GameSetup (_1: t_GameSetup)

let rec restart (self_: t_GameFinished) (return (x: t_GameSetup)) =
  {[@stop_split] [@expl:restart 'self_' type invariant] [%#svsm_extern_specs] inv_GameFinished self_}

constant const_MAX_PLAYER_HANDS: UInt64.t = [%#shand] (4: UInt64.t)

predicate blackjack_consistent [#"/home/erik/repos/strictly_games/crates/strictly_proofs/src/creusot_proofs/generated/blackjack_vsm.rs" 18 0 18 59] (state: t_BlackjackState) =
  [%#sblackjack_vsm'6] match state with
    | Setup _ _ -> true
    | Betting inner _ -> UInt64.t'int inner.bankroll > 0

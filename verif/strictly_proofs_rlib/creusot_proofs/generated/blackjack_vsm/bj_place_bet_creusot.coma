let rec elim_Betting (_x: t_BlackjackState) (return (inner: t_GameBetting) (display_mode: t_BlackjackDisplayMode)) = any
  [ _k (inner: t_GameBetting) (display_mode: t_BlackjackDisplayMode) -> {Betting inner display_mode = _x}
    (! return {inner} {display_mode})
  | _chk -> (! {[@expl:elim Betting] match _x with
      | Betting _ _ -> true
      | _ -> false
      end}
    any) ]


    | s2 = elim_Ok {_15}
        (fun (r0: t_GameResult) -> elim_PlayerTurn {r0} (fun (r0'0: t_GamePlayerTurn) -> [ &pt <- r0'0 ] s3))
    | s3 = [ &_21 <- PlayerTurn pt display_mode ] s4
    | s4 = [ &_ret <- { f0 = _21; f1 = proof } ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: tup2_BlackjackState_Established_BlackjackConsistent = Any.any_l ()
  | & state: t_BlackjackState = state
  | & proof: t_Established_BlackjackConsistent = proof
  | & bet'0: UInt64.t = bet'0
  | & betting: t_GameBetting = Any.any_l ()
  | & display_mode: t_BlackjackDisplayMode = Any.any_l ()
  | & fallback: t_GameBetting = Any.any_l ()
  | & _15: t_Result_GameResult_ActionError = Any.any_l ()
  | & pt: t_GamePlayerTurn = Any.any_l ()
  | & _21: t_BlackjackState = Any.any_l ()
  | & dt: t_GameDealerTurn = Any.any_l ()
  | & _26: t_BlackjackState = Any.any_l ()
  | & finished: t_GameFinished = Any.any_l ()
  | & _settled: t_Established_PayoutSettled = Any.any_l ()
  | & _32: t_BlackjackState = Any.any_l ()
  | & _36: t_BlackjackState = Any.any_l () ])
  [ return (result: tup2_BlackjackState_Established_BlackjackConsistent) ->
  {[@stop_split] [@expl:bj_place_bet__creusot ensures] ([@stop_split] [@expl:bj_place_bet__creusot result type invariant] [%#sblackjack_vsm'4] inv_tup2_BlackjackState_Established_BlackjackConsistent result)
    /\ ([@stop_split] [@expl:bj_place_bet__creusot ensures] [%#sblackjack_vsm'5] blackjack_consistent result.f0)}
    (! return {result}) ]

predicate inv_Established_BlackjackConsistent (_1: t_Established_BlackjackConsistent)

let rec prove_BlackjackConsistent (_credential: t_BettingStateEvidence)
  (return (x: t_Established_BlackjackConsistent)) =
  {[@stop_split] [@expl:prove '_credential' type invariant] [%#svsm_extern_specs] inv_ref_BettingStateEvidence _credential}
  any
  [ return (result: t_Established_BlackjackConsistent) ->
  {[@stop_split] [@expl:prove result type invariant] [%#scontracts] inv_Established_BlackjackConsistent result}
    (! return {result}) ]


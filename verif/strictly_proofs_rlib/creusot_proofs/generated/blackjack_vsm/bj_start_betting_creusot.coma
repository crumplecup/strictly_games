use creusot.int.UInt64
use creusot.slice.Slice64
use creusot.prelude.Any
use seq.Seq
use int.Int

type t_GameSetup

type t_BlackjackDisplayMode = Table | Scorecard

type t_Shoe

type t_GameBetting = { shoe: t_Shoe; bankroll: UInt64.t }

type t_Hand

type t_BankrollLedger = { post_bet_balance: UInt64.t; bet: UInt64.t }

type t_Established_BetDeducted

type t_GamePlayerTurn = {
  shoe'0: t_Shoe;
  player_hands'0: Slice64.array t_Hand;
  num_hands'0: UInt64.t;
  current_hand_index'0: UInt64.t;
  dealer_hand'0: t_Hand;
  bets'0: Slice64.array UInt64.t;
  ledger'0: t_BankrollLedger;
  bet_deducted'0: t_Established_BetDeducted }

type t_GameDealerTurn = {
  shoe'1: t_Shoe;
  player_hands'1: Slice64.array t_Hand;
  num_hands'1: UInt64.t;
  dealer_hand'1: t_Hand;
  bets'1: Slice64.array UInt64.t;
  ledger'1: t_BankrollLedger;
  bet_deducted'1: t_Established_BetDeducted }

type t_Outcome = Win | Blackjack | Push | Loss | Surrender

type t_GameFinished = {
  player_hands'2: Slice64.array t_Hand;
  num_hands'2: UInt64.t;
  dealer_hand'2: t_Hand;
  bets'2: Slice64.array UInt64.t;
  outcomes'2: Slice64.array t_Outcome;
  bankroll'2: UInt64.t }

type t_BlackjackState =
  | Setup t_GameSetup t_BlackjackDisplayMode
  | Betting t_GameBetting t_BlackjackDisplayMode
  | PlayerTurn t_GamePlayerTurn t_BlackjackDisplayMode
  | DealerTurn t_GameDealerTurn t_BlackjackDisplayMode
  | Finished t_GameFinished t_BlackjackDisplayMode

type t_Established_BlackjackConsistent

type tup2_BlackjackState_Established_BlackjackConsistent = {
  f0: t_BlackjackState;
  f1: t_Established_BlackjackConsistent }

let rec elim_Setup (_x: t_BlackjackState) (return (inner: t_GameSetup) (display_mode: t_BlackjackDisplayMode)) = any
  [ _k (inner: t_GameSetup) (display_mode: t_BlackjackDisplayMode) -> {Setup inner display_mode = _x}
    (! return {inner} {display_mode})
  | _chk -> (! {[@expl:elim Setup] match _x with
      | Setup _ _ -> true
      | _ -> false
      end}
    any) ]

type t_Established_BankrollPositive

type t_BettingStateEvidence = { bankroll_positive: t_Established_BankrollPositive }

predicate inv_Established_BankrollPositive (_1: t_Established_BankrollPositive)

predicate inv_BettingStateEvidence (_1: t_BettingStateEvidence)

axiom inv_axiom [@rewrite]: forall x: t_BettingStateEvidence [inv_BettingStateEvidence x]. inv_BettingStateEvidence x
    = inv_Established_BankrollPositive x.bankroll_positive

predicate resolve_Established_BankrollPositive (_1: t_Established_BankrollPositive)

predicate resolve_BettingStateEvidence (_1: t_BettingStateEvidence)

axiom resolve_axiom [@rewrite]:
  forall x: t_BettingStateEvidence [resolve_BettingStateEvidence x]. resolve_BettingStateEvidence x
    = resolve_Established_BankrollPositive x.bankroll_positive

predicate invariant_ref_BettingStateEvidence [@inline:trivial] (self: t_BettingStateEvidence) =

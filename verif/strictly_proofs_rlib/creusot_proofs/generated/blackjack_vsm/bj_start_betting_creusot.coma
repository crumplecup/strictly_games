predicate inv_Shoe (_1: t_Shoe)

predicate inv_GameBetting (_1: t_GameBetting)

axiom inv_axiom'0 [@rewrite]: forall x: t_GameBetting [inv_GameBetting x]. inv_GameBetting x = inv_Shoe x.shoe

let rec start_betting (self_: t_GameSetup) (initial_bankroll: UInt64.t) (return (x: t_GameBetting)) =
  {[@stop_split] [@expl:start_betting 'self_' type invariant] [%#svsm_extern_specs'1] inv_GameSetup self_}
  any
  [ return (result: t_GameBetting) ->
  {[@stop_split] [@expl:start_betting ensures] ([@stop_split] [@expl:start_betting result type invariant] [%#stypestate] inv_GameBetting result)

    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_Result_GameResult_ActionError _21} any) ]
    | s1 = -{resolve_Result_GameResult_ActionError _21}- s2
    | s2 = elim_Ok {_21}
        (fun (r0: t_GameResult) ->
          elim_Finished {r0} (fun (r0'0: t_GameFinished) (r1: t_Established_PayoutSettled) -> [ &finished <- r0'0 ] s3))
    | s3 = elim_Ok {_21}
        (fun (r0: t_GameResult) ->
          elim_Finished {r0} (fun (r0'0: t_GameFinished) (r1: t_Established_PayoutSettled) -> [ &_settled <- r1 ] s4))
    | s4 = [ &_38 <- Finished finished display_mode ] s5
    | s5 = [ &_ret <- { f0 = _38; f1 = new_proof } ] s6
    | s6 = return {_ret} ]
  | bb10 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_Result_GameResult_ActionError _21} any) ]
    | s1 = -{resolve_Result_GameResult_ActionError _21}- s2
    | s2 = elim_Ok {_21}
        (fun (r0: t_GameResult) -> elim_DealerTurn {r0} (fun (r0'0: t_GameDealerTurn) -> [ &dt <- r0'0 ] s3))
    | s3 = [ &_32 <- DealerTurn dt display_mode ] s4
    | s4 = [ &_ret <- { f0 = _32; f1 = new_proof } ] s5
    | s5 = return {_ret} ]
  | bb9 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_Result_GameResult_ActionError _21} any) ]
    | s1 = -{resolve_Result_GameResult_ActionError _21}- s2
    | s2 = elim_Ok {_21}
        (fun (r0: t_GameResult) -> elim_PlayerTurn'0 {r0} (fun (r0'0: t_GamePlayerTurn) -> [ &pt2 <- r0'0 ] s3))
    | s3 = [ &_27 <- PlayerTurn pt2 display_mode ] s4
    | s4 = [ &_ret <- { f0 = _27; f1 = new_proof } ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: tup2_BlackjackState_Established_BlackjackConsistent = Any.any_l ()
  | & state: t_BlackjackState = state
  | & proof: t_Established_BlackjackConsistent = proof
  | & action: t_BasicAction = action
  | & valid_proof: t_Established_ValidAction = valid_proof
  | & bust_proof: t_Established_NotBust = bust_proof
  | & pt: t_GamePlayerTurn = Any.any_l ()
  | & display_mode: t_BlackjackDisplayMode = Any.any_l ()
  | & new_proof: t_Established_BlackjackConsistent = Any.any_l ()
  | & _17: t_BlackjackRulesEvidence = Any.any_l ()
  | & _18: t_BlackjackRulesEvidence = Any.any_l ()
  | & _21: t_Result_GameResult_ActionError = Any.any_l ()
  | & pt2: t_GamePlayerTurn = Any.any_l ()
